{
  "name": "apps-gateway",
  "private": true,
  "type": "module",
  "version": "1.11.3",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "sync:providers": "tsx src/jobs/sync.ts",
    "sync:freellms": "python ../../scripts/sync-freellms.py",
    "verify:free": "tsx src/jobs/verify-free.ts",
    "verify:free:dry": "tsx src/jobs/verify-free.ts --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "cockatiel": "^4.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.7.4",
    "ioredis": "^5.4.1",
    "js-tiktoken": "^1.0.21",
    "lru-cache": "^10.4.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "simple-statistics": "^7.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/lru-cache": "^7.10.9",
    "@types/node": "^22.10.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
