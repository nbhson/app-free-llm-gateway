# Gateway runtime data (ephemeral, generated at runtime — fresh on clone)
# All JSON under data/ is generated via: `scripts/sync-freellms.py` or `POST /api/models/live/sync` / `POST /api/verify`
# Keep data/ empty for new users; run sync jobs to populate.
data/*.json
data/**/*.json
!data/.gitkeep
apps/data/*
!apps/data/.gitkeep
apps/data/*.json
apps/data/**/*.json

